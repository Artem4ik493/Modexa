# At least one bot token is required for Runner to stay running.
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Use a long random secret; do not leave the default value.
MODEXA_API_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Optional comma-separated origins for a separately hosted Dashboard; leave empty for same-origin only.
MODEXA_ALLOWED_ORIGINS=
MODEXA_DATABASE_PATH=/app/data/modexa.sqlite
MODEXA_OWNER_EXTERNAL_IDS=

HOST=0.0.0.0
PORT=3000

# Discord OAuth is optional. Set these when enabling dashboard Discord login.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_PERMISSIONS=
DISCORD_REDIRECT_URI=https://YOUR_DOMAIN/auth/discord/callback
MODEXA_DASHBOARD_URL=https://YOUR_DOMAIN/
