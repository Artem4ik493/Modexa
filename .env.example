# Configure at least one bot token. Keep this file private and never commit it.
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Generate with: openssl rand -hex 32
MODEXA_API_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Dashboard and API are same-origin, so leave this empty unless you add other frontends.
MODEXA_ALLOWED_ORIGINS=
MODEXA_DATABASE_PATH=/app/data/modexa.sqlite
# Optional comma-separated external owner IDs.
MODEXA_OWNER_EXTERNAL_IDS=

HOST=0.0.0.0
PORT=3000

# Discord OAuth2. Register the exact callback URL in Discord Developer Portal.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_PERMISSIONS=
DISCORD_REDIRECT_URI=https://api.artem4ik493.ru/auth/discord/callback
MODEXA_DASHBOARD_URL=https://api.artem4ik493.ru/
